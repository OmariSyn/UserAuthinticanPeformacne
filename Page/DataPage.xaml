    <ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 x:Class="PerformanceApp.Page.DataPage"
                 Title="Data Entry">
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Title -->
            <Label Text="Data Entry Page"
                   FontSize="24"
                   HorizontalOptions="Center" />

            <!-- Data Entry Fields -->
            <Label Text="Enter Data:" FontSize="14" />
            <Entry Placeholder="Enter some data here" />

            <!-- Submit Button -->
            <Button Text="Submit" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ContentPage>